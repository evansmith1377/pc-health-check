<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Health Check" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0F1115" Foreground="#E8EBF1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#4F7DF3"/>
      <Setter Property="BorderBrush" Value="#4F7DF3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#E8EBF1"/>
      <Setter Property="Background" Value="#1C212B"/>
      <Setter Property="BorderBrush" Value="#2C3341"/>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#8FB0FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,4"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#B9CEFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Foreground" Value="#B5BCC9"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FixButton" TargetType="Button">
      <Setter Property="Foreground" Value="#DCE4FF"/>
      <Setter Property="Background" Value="#1F2A44"/>
      <Setter Property="BorderBrush" Value="#2F3D63"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,5,11,6">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9AA3B2"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="16" Padding="14,6" Background="Transparent" BorderBrush="#2A303C" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#4A5263"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E8EBF1"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#E8EBF1"/>
                <Setter Property="Foreground" Value="#0F1115"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Background="#343B49" Margin="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#222833" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="#4F7DF3" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Background="#0F1115">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image x:Name="TitleIcon" Width="18" Height="18"/>
          <TextBlock Text="PC Health Check" Margin="10,0,0,0" FontSize="12.5" Foreground="#9AA3B2" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"/>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"/>
          <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#141720" BorderBrush="#1F2430" BorderThickness="0,1,1,0">
          <DockPanel Margin="28,24,28,22">
            <StackPanel DockPanel.Dock="Bottom">
              <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ScanGlyph" FontFamily="{StaticResource Icons}" Text="&#xE72C;" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ScanLabel" Text="Scan again" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="DeepButton" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock Text="Run deep scan" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="DeepHint" Text="Adds drive wear, chkdsk, DISM and SFC checks. Takes 15-30 minutes and needs administrator permission."
                         TextWrapping="Wrap" FontSize="12" Foreground="#6F788A" Margin="2,8,2,0" LineHeight="17"/>
              <Button x:Name="ReportButton" Style="{StaticResource LinkButton}" Margin="2,16,0,0" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8A7;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="Open full report in browser" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="#5C6577" Margin="2,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,16" Padding="0,0,12,0">
            <StackPanel>
              <Grid Width="156" Height="156" HorizontalAlignment="Left">
                <Ellipse Stroke="#222833" StrokeThickness="10" Margin="6"/>
                <Path x:Name="ScoreArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#4F7DF3"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="ScoreText" Text="--" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"
                             FontFamily="Segoe UI Variable Display, Segoe UI"/>
                  <TextBlock x:Name="ScoreCaption" Text="health score" FontSize="12" Foreground="#7D8697" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="VerdictText" Text="Starting up..." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,22,0,0"
                         FontFamily="Segoe UI Variable Display, Segoe UI"/>
              <TextBlock x:Name="VerdictSub" Text="" FontSize="13.5" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>

              <UniformGrid Columns="2" Rows="2" Margin="0,20,0,0">
                <Border Background="#1A1E28" CornerRadius="10" Padding="14,10" Margin="0,0,5,10">
                  <StackPanel>
                    <TextBlock x:Name="CountProblem" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                    <TextBlock Text="Need attention" FontSize="12" Foreground="#8C95A6"/>
                  </StackPanel>
                </Border>
                <Border Background="#1A1E28" CornerRadius="10" Padding="14,10" Margin="5,0,0,10">
                  <StackPanel>
                    <TextBlock x:Name="CountWarning" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#F5B94C"/>
                    <TextBlock Text="Worth a look" FontSize="12" Foreground="#8C95A6"/>
                  </StackPanel>
                </Border>
                <Border Background="#1A1E28" CornerRadius="10" Padding="14,10" Margin="0,0,5,0">
                  <StackPanel>
                    <TextBlock x:Name="CountGood" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#3DD68C"/>
                    <TextBlock Text="Looking good" FontSize="12" Foreground="#8C95A6"/>
                  </StackPanel>
                </Border>
                <Border Background="#1A1E28" CornerRadius="10" Padding="14,10" Margin="5,0,0,0">
                  <StackPanel>
                    <TextBlock x:Name="CountInfo" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#6AA8EA"/>
                    <TextBlock Text="For your info" FontSize="12" Foreground="#8C95A6"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="36,26,36,6">
            <TextBlock Text="Results" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <WrapPanel Margin="0,16,0,0">
              <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" GroupName="f" IsChecked="True" Content="All"/>
              <RadioButton x:Name="FilterProblem" Style="{StaticResource Chip}" GroupName="f" Content="Need attention"/>
              <RadioButton x:Name="FilterWarning" Style="{StaticResource Chip}" GroupName="f" Content="Worth a look"/>
              <RadioButton x:Name="FilterGood" Style="{StaticResource Chip}" GroupName="f" Content="Looking good"/>
              <RadioButton x:Name="FilterInfo" Style="{StaticResource Chip}" GroupName="f" Content="For your info"/>
            </WrapPanel>
            <StackPanel x:Name="ProgressPanel" Margin="0,8,0,4">
              <Grid>
                <TextBlock x:Name="ProgressText" FontSize="12.5" Foreground="#9AA3B2"/>
                <TextBlock x:Name="ProgressCount" FontSize="12.5" Foreground="#6F788A" HorizontalAlignment="Right"/>
              </Grid>
              <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="1"/>
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,8,26,30">
            <StackPanel x:Name="ResultsPanel" Margin="0,0,10,0"/>
          </ScrollViewer>

          <!-- Notification shown after a quick fix is launched -->
          <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="0,0,0,24" Background="#232937" BorderBrush="#343C4D" BorderThickness="1" CornerRadius="10" Padding="16,11" MaxWidth="560">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ToastGlyph" FontFamily="{StaticResource Icons}" Text="&#xE945;" FontSize="14" Foreground="#8FB0FF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Confirmation dialog for quick fixes that change something -->
      <Grid x:Name="Overlay" Grid.Row="1" Visibility="Collapsed" Background="#C0080A0E">
        <Border Width="540" Background="#171B24" BorderBrush="#2C3341" BorderThickness="1" CornerRadius="14" Padding="28,24,28,24"
                VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Grid Width="36" Height="36">
                <Ellipse Fill="#2A4F7DF3"/>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE945;" FontSize="15" Foreground="#8FB0FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                         FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>
            <TextBlock x:Name="DialogText" Foreground="#B5BCC9" FontSize="13.5" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20"/>
            <TextBlock Text="WHAT WILL RUN" FontSize="11" FontWeight="SemiBold" Foreground="#6F788A" Margin="0,18,0,6"/>
            <TextBox x:Name="DialogCommand" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#0F1115" Foreground="#C9D1DD"
                     BorderThickness="1" BorderBrush="#232937" Padding="12,10" SelectionBrush="#4F7DF3"/>
            <StackPanel x:Name="DialogAdmin" Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="13" Foreground="#F5B94C" VerticalAlignment="Center"/>
              <TextBlock Text="Windows will ask for administrator permission." FontSize="12.5" Foreground="#B5BCC9" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="It runs in its own window so you can watch it. Scan again afterwards to see the result." FontSize="12.5"
                       Foreground="#7D8697" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="DialogCancel" Style="{StaticResource SecondaryButton}" Width="110" Height="40" Content="Cancel"/>
              <Button x:Name="DialogRun" Style="{StaticResource PrimaryButton}" Width="130" Height="40" Margin="10,0,0,0" Content="Run fix"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
